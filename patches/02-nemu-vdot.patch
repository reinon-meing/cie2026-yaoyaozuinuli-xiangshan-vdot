 }
 
+// CIE 香山赛道自定义 vdot.vv（与香山 RTL / 设计文档同语义）
+//   - 只定义 SEW=8；SEW≠8 与香山 RTL 一致地触发非法指令异常
+//   - 取 vs1/vs2 的字节 0..7 做 int8 符号扩展点积，int32 结果写入 vd 最低 4 字节（小端）
+//   - vd 的其余位清零，与 vl / vstart / 掩码无关
+def_EHelper(vdot) {
+  require_vector(true);
+  if (vtype->vsew != 0) {
+    longjmp_exception(EX_II);
+  }
+  int32_t sum = 0;
+  for (int i = 0; i < 8; i++) {
+    // 注意：NEMU 的 rtl.h 里 s0/s1/s2 是宏，局部变量不能叫 s1/s2
+    rtlreg_t vs1_val, vs2_val;
+    // vsew=0（字节宽）、按 m1 的字节索引取；src2/src1 顺序对乘法交换律无影响
+    get_vreg(id_src2->reg, i, &vs1_val, 0, vtype->vlmul, 1, 0);
+    get_vreg(id_src1->reg, i, &vs2_val, 0, vtype->vlmul, 1, 0);
+    sum += (int32_t)(vs1_val * vs2_val);
+  }
+  // 整寄存器写回：先把 vd 低 128 位的 16 个字节清零，再写小端 int32 结果
+  for (int i = 0; i < VLEN / 8; i++) {
+    set_vreg(id_dest->reg, i, 0, 0, vtype->vlmul, 0);
+  }
+  for (int i = 0; i < 4; i++) {
+    set_vreg(id_dest->reg, i, ((uint32_t)sum >> (8 * i)) & 0xff, 0, vtype->vlmul, 0);
+  }
+  vp_set_dirty();
+}
+
 def_EHelper(vsub) {
   ARITH(SUB, SIGNED)
 }
